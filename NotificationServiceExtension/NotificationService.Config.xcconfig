// Configuration settings file format documentation can be found at:
// https://help.apple.com/xcode/#/dev745c5c974

// DEV | STAGING | PROD
SERVICE_ENV = STAGING

// Bundle Identifier
_APP_BUNDLE_ID_PROD     = com.manuelrm.bovedapp.prod.mainnet.NotificationServiceExtension
_APP_BUNDLE_ID_STAGING  = com.manuelrm.bovedapp.staging.mainnet.NotificationServiceExtension
_APP_BUNDLE_ID_DEV      = com.manuelrm.bovedapp.dev.mainnet.NotificationServiceExtension

// Xcode Build Settings
PRODUCT_BUNDLE_IDENTIFIER           = $(_APP_BUNDLE_ID_$(SERVICE_ENV):default=$(_APP_BUNDLE_ID_PROD))
PRODUCT_MODULE_NAME                 = NotificationServiceExtension
PRODUCT_NAME                        = NotificationServiceExtension

// App Groups
_APP_GROUP_ID_PROD     = group.com.manuelrm.bovedapp.prod.mainnet
_APP_GROUP_ID_STAGING  = group.com.manuelrm.bovedapp.staging.mainnet
_APP_GROUP_ID_DEV      = group.com.manuelrm.bovedapp.dev.mainnet

APP_GROUP_ID            = $(_APP_GROUP_ID_$(SERVICE_ENV):default=$(_APP_GROUP_ID_PROD))
